PORT=3006

MONGODB_URI=mongodb://messageservice:password@mongodb:27017/messagedb

AUTH_URL=https://auth.freischule.info

# ObjectService — channel membership lookup (channels collection, data.memberIds)
OBJECT_SERVICE_URL=https://object.freischule.info
OBJECT_SERVICE_API_KEY=your-object-service-api-key-here
# Channel-membership cache window in ms. Removed members keep access until expiry.
# Default 10000; set 0 to disable caching (instant revocation).
CHANNEL_MEMBERSHIP_TTL_MS=10000

EMAIL_SERVICE_URL=https://email.freischule.info
EMAIL_SERVICE_API_KEY=your-email-service-api-key-here
